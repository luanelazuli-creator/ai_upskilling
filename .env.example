# Modo de Execução
ENV=development

# --- Identidade do usuário (single-user no MVP; SPEC-003-2) ---
USER_ID=luane
SESSION_ID=                       # vazio => gerado por sessão (UUID)

# --- Ollama (agente de síntese) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama            # tinyllama, mistral (instale com: ollama pull)
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# --- Ollama (agente de triagem; SPEC-005) ---
OLLAMA_TRIAGE_MODEL=qwen2.5:3b
OLLAMA_TRIAGE_TEMPERATURE=0.1
OLLAMA_TRIAGE_TIMEOUT_S=10
# Limiares da política híbrida (SPEC-005 §4)
TRIAGE_RULES_CONFIDENCE_THRESHOLD=0.7
TRIAGE_CLARIFY_CONFIDENCE_THRESHOLD=0.6
TRIAGE_MAX_CLARIFICATION_ROUNDS=2

# --- Ollama (agente de síntese; SPEC-006) ---
OLLAMA_SYNTHESIS_MODEL=mistral
OLLAMA_SYNTHESIS_TEMPERATURE=0.3
OLLAMA_SYNTHESIS_MAX_TOKENS=1024
OLLAMA_SYNTHESIS_TIMEOUT_S=30
# Limiar mínimo de relevância máxima do bundle (SPEC-006 §5).
# Abaixo disso, devolve NoEvidence(low_relevance) sem chamar o LLM.
SYNTHESIS_MIN_RELEVANCE_SCORE=0.25

# --- Agent Configuration ---
AGENT_NAME=SecondBrain-Basic
AGENT_VERSION=0.1.0

# --- Data Paths ---
DATA_ROOT=./data
PROCESSED_ROOT=./data/processed
VECTORSTORE_PATH=./data/vectorstore     # ChromaDB unificado (SPEC-003-2 §5)
EPISODIC_METADATA_DB=./data/episodic_metadata.db

# --- Embedding (SPEC-004 §5) ---
# chroma_default = ONNX all-MiniLM-L6-v2 (leve, sem torch; bom p/ testes)
# fake           = determinístico por hash (testes de mecânica, zero download)
# <model_name>   = sentence-transformers, ex.: paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=chroma_default

# --- Chunking adaptativo (SPEC-004 §4) ---
CHUNK_SIZE_DEFAULT=1000
CHUNK_OVERLAP_DEFAULT=200

# --- Retenção (SPEC-MEM §7) ---
EPISODIC_RETENTION_DAYS=90

# --- Orquestrador (SPEC-008 §11) ---
SESSION_USER_ID=luane                       # single-user MVP
MAX_CONTEXT_TOKENS=4096                     # orçamento total do ContextBundle
WORKING_MEMORY_CAPACITY=10                  # tier 1 (SPEC-MEM §4.1)
RAG_TOP_K_PER_COLLECTION=5
EPISODIC_RECENT_N=3
EPISODIC_SEMANTIC_TOP_K=3
SEMANTIC_TOP_K=5
META_INTENT_RESPONSE="Sou seu Second Brain. Posso ajudar com seu diário pessoal, progresso de cursos e referências (manuais, stakeholders, glossário). Faça uma pergunta sobre essas fontes."
ORCHESTRATOR_TURN_TIMEOUT_S=60              # ceil global do turno (segundos)
