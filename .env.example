# Modo de Execução
ENV=development

# --- Identidade do usuário (single-user no MVP; SPEC-003-2) ---
USER_ID=luane
SESSION_ID=                       # vazio => gerado por sessão (UUID)

# --- Ollama (agente de síntese) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama            # tinyllama, mistral (instale com: ollama pull)
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# --- Ollama (agente de triagem; SPEC-005) ---
OLLAMA_TRIAGE_MODEL=qwen2.5:3b
OLLAMA_TRIAGE_TEMPERATURE=0.1
OLLAMA_TRIAGE_TIMEOUT_S=10

# --- Agent Configuration ---
AGENT_NAME=SecondBrain-Basic
AGENT_VERSION=0.1.0

# --- Data Paths ---
DATA_ROOT=./data
PROCESSED_ROOT=./data/processed
VECTORSTORE_PATH=./data/vectorstore     # ChromaDB unificado (SPEC-003-2 §5)
EPISODIC_METADATA_DB=./data/episodic_metadata.db

# --- Embedding (SPEC-004 §5) ---
# chroma_default = ONNX all-MiniLM-L6-v2 (leve, sem torch; bom p/ testes)
# fake           = determinístico por hash (testes de mecânica, zero download)
# <model_name>   = sentence-transformers, ex.: paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=chroma_default

# --- Chunking adaptativo (SPEC-004 §4) ---
CHUNK_SIZE_DEFAULT=1000
CHUNK_OVERLAP_DEFAULT=200

# --- Retenção (SPEC-MEM §7) ---
EPISODIC_RETENTION_DAYS=90
